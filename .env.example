# ==============================================================================
# IA MENTOR DE CARREIRA - CONFIGURAÇÕES DO SISTEMA MULTIAGENTE
# ==============================================================================

# Chave de API oficial da OpenAI (Obtenha em: https://platform.openai.com)
# ATENÇÃO: Nunca envie o seu arquivo '.env' real com a chave preenchida para o GitHub!
OPENAI_API_KEY=your_openai_api_key_here

# Modelo da LLM utilizado para a orquestração do Agent 2 (Planejador)
# Sugestões: gpt-4o-mini (rápido e econômico) ou gpt-4o (avançado)
OPENAI_MODEL=gpt-4o-mini

# Ambiente de execução da aplicação (development, production, test)
NODE_ENV=development

# Configurações opcionais para logs e observabilidade (ex: Langfuse)
# ENABLE_LOGS=true
